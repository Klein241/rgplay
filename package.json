{
  "name": "rg-play-audiobooks",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cf:d1:init": "wrangler d1 execute rg-play-db --local --file=./migrations/0001_init.sql",
    "cf:d1:init:remote": "wrangler d1 execute rg-play-db --remote --file=./migrations/0001_init.sql",
    "cf:pages:dev": "wrangler pages dev dist --compatibility-flag=nodejs_compat --d1=DB=rg-play-db --r2=AUDIO_BUCKET=rg-play-audio",
    "cf:deploy": "wrangler pages deploy dist --project-name=rg-play"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@tailwindcss/vite": "^4.3.3",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "wrangler": "^3.114.0"
  }
}
